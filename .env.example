# ==============================================================================
# Map Concerts (现场档案馆) Environment Configuration Template (.env.example)
#
# Copy this file to .env or .dev.vars for local testing if needed:
#   cp .env.example .dev.vars
# ==============================================================================

# 1. Cloudflare API Token (Optional, for CI/CD or CLI remote operations)
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# 2. Admin Review Password
# For production, set via: npx wrangler secret put ADMIN_PASSWORD
ADMIN_PASSWORD=your_secure_admin_password_here

# 3. First Bootstrap Admin Username (Configured in wrangler.toml [vars])
BOOTSTRAP_ADMIN=admin
